# Copie para .env.local e preencha:
#   cp .env.example .env.local   (Linux/Mac)
#   copy .env.example .env.local (Windows)

# Pipedrive — https://app.pipedrive.com/settings/api
PIPEDRIVE_API_KEY=

# ClickUp — Settings → Apps → API Token
CLICKUP_API_TOKEN=
CLICKUP_TEAM_ID=

# all | pipedrive | clickup
SYNC_SCOPE=all

# Produção (Basic Auth do dashboard)
DASHBOARD_AUTH_USER=
DASHBOARD_AUTH_PASSWORD=

# PostgreSQL do Railway — artefatos processados, histórico analítico e módulo financeiro
DATABASE_URL=
ARTIFACT_STORAGE=postgres
DATA_DIR=

# Asaas — https://www.asaas.com/customerConfigIntegrations/apiKey
# A chave começa com "$aact_". Em .env não use aspas nem barra invertida antes do
# cifrão: o loader lê o arquivo literalmente e um "\$" vira parte da chave,
# devolvendo 401 sem explicação.
#
# A chave de leitura NÃO precisa de permissão de transferência nem de pagamento
# de contas. Mantê-la sem esses escopos é o que impede um vazamento de virar
# perda financeira. Quando houver automação de pagamento, emitir uma SEGUNDA
# chave só para isso, guardada apenas nas variáveis do Railway.
ASAAS_API_KEY=
ASAAS_API_URL=https://api.asaas.com/v3
ASAAS_SYNC_WINDOW_DAYS=45

# Banco Inter — API Banking (conta PJ). Só leitura de extrato.
#
# A aplicação foi criada no Internet Banking com o escopo `extrato.read` e mais
# nenhum: sem transferência, sem pagamento. É a mesma postura da chave do Asaas,
# e é o que impede um vazamento de virar perda financeira. Emissão de boleto ou
# Pix, quando existir, pede uma SEGUNDA aplicação — nunca ampliar esta.
#
# A autenticação é mTLS: além do id e do secret, existe um par certificado/chave.
# No local eles ficam em secrets/ (fora do git). No Railway não há como subir
# arquivo, então vão em base64 — gere sem imprimir na tela:
#   base64 -i secrets/*.crt | pbcopy   → INTER_CERT_B64
#   base64 -i secrets/*.key | pbcopy   → INTER_KEY_B64
INTER_CLIENT_ID=
INTER_CLIENT_SECRET=
# Local: opcionais. Sem elas, o código acha o único .crt/.key dentro de secrets/
# — o Inter entrega os arquivos com espaço no nome, e caminho com espaço em
# variável de ambiente quebra em shell na primeira distração.
# INTER_CERT_PATH=
# INTER_KEY_PATH=
# Produção (Railway): o par em base64, escrito em disco no boot.
# INTER_CERT_B64=
# INTER_KEY_B64=
INTER_SYNC_WINDOW_DAYS=45
INTER_HISTORICO_DESDE=2025-09-01

# Planejado (etapas futuras)
# CLICKUP_WEBHOOK_SECRET=
# VOYAGE_API_KEY=
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Banco do módulo financeiro — DECLARADO, não herdado.
#
# DATABASE_URL tem valor diferente em cada ambiente (local vem do .env.local, no
# Railway a plataforma injeta o dela). Um ledger que herda essa variável grava em
# desenvolvimento num banco e lê em produção de outro — sem erro nenhum, só
# números que não existem. Aponte esta para o banco onde o financeiro deve morar,
# igual nos dois ambientes.
FINANCE_DATABASE_URL=

# Nubank — as duas etapas que entraram no botão em 01/09/2026.
#
# Localmente estas quatro saem do `.env.obras`, que é o `.env.local` INTEIRO do
# erp-obras. Esse arquivo NÃO vai para o deploy (`.env*` está no .gitignore), e
# por isso o ambiente precisa carregá-las em produção — sem elas o espelho e o
# fechamento de saldo falham no Railway funcionando aqui, que é o pior formato
# de erro: verde na máquina de quem escreveu, vermelho onde importa.
#
# O nome é ERP_OBRAS_DIRECT_URL e não DIRECT_URL de propósito: já existe uma
# DIRECT_URL no painel e ninguém sabe dizer, olhando, para qual banco ela aponta.
# É o session pooler (5432) do Supabase do erp-obras — o transaction pooler
# (6543) derruba consulta analítica longa. A sessão abre READ ONLY.
ERP_OBRAS_DIRECT_URL=

# Polp (open finance). Hoje só o saldo da conta corrente é usado pelo pipeline,
# em GET /integrations/{id}/accounts. As caixinhas (GET .../investments) ficaram
# FORA do agendador enquanto a paginação da fonte não fechar — ver a 0190.
POLP_API_CLIENT=
POLP_API_SECRET=
POLP_INTEGRATION_ID=
# POLP_API_BASE_URL=https://api.polp.com.br/api/v1
