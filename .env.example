# Copie para .env.local e preencha:
#   cp .env.example .env.local   (Linux/Mac)
#   copy .env.example .env.local (Windows)

# Pipedrive — https://app.pipedrive.com/settings/api
PIPEDRIVE_API_KEY=

# ClickUp — Settings → Apps → API Token
CLICKUP_API_TOKEN=
CLICKUP_TEAM_ID=

# all | pipedrive | clickup
SYNC_SCOPE=all

# Produção (Basic Auth do dashboard)
DASHBOARD_AUTH_USER=
DASHBOARD_AUTH_PASSWORD=

# PostgreSQL do Railway — artefatos processados e histórico analítico
DATABASE_URL=
ARTIFACT_STORAGE=postgres
DATA_DIR=

# Claude (Gestor IA da página de Marketing) — sem a chave a análise
# numérica continua funcionando; só o parecer do modelo fica indisponível.
ANTHROPIC_API_KEY=

# Planejado (etapas futuras)
# CLICKUP_WEBHOOK_SECRET=
# VOYAGE_API_KEY=
# NEXT_PUBLIC_APP_URL=http://localhost:3000
